VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/mlgzpyqv

# Public portal client configuration. The anon key is intentionally safe for
# browser use when the migration's row-level security policies are applied.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_AUTH_ENABLED=false

# Local review only. This flag has no effect in a production build.
VITE_PORTAL_DEMO_MODE=true

# Server-only portal configuration. Never prefix these values with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PORTAL_PUBLIC_URL=https://portal.deepbridgeadvisory.co.uk

# Google Workspace eSignature is operated from the restricted DeepBridge Drive
# folder. Google currently has no public embedded-signing API, so the portal
# records the request and imports the completed PDF and audit trail.
PORTAL_SIGNING_PROVIDER=google_workspace

# Secret shared only with the configured malware scanning service.
MALWARE_SCAN_CALLBACK_SECRET=
